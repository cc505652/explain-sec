{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "migrate": "node scripts/migrate.js",
    "test:mt1": "node --test test/mt1.integration.test.js",
    "test:mt2": "node --test test/mt2.integration.test.js",
    "test:mt3": "node --test test/mt3.integration.test.js",
    "test:mt4": "node --test test/mt4.integration.test.js",
    "test:mt5": "node --test test/mt5.integration.test.js",
    "test:audit": "node --test test/authorizationAudit.integration.test.js",
    "test:integration": "node --test test/mt1.integration.test.js && node --test test/mt2.integration.test.js && node --test test/mt3.integration.test.js && node --test test/mt4.integration.test.js && node --test test/mt5.integration.test.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "index.js",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.4.1"
  },
  "private": true
}
